# Unity Performance Rules

## Update/FixedUpdate/LateUpdate

### Usage Rules

```csharp
using UnityEngine;

public class PerformanceExample : MonoBehaviour
{
    private Rigidbody _rigidbody;
    
    // ✅ DO: Cache components in Awake/Start
    private void Awake()
    {
        _rigidbody = GetComponent<Rigidbody>();
    }
    
    // ❌ DON'T: Frequent GetComponent calls in Update
    /* 
    private void Update()
    {
        GetComponent<Rigidbody>().AddForce(Vector3.up); // Bad! Expensive call every frame.
    }
    */
    
    private void FixedUpdate()
    {
        // ✅ DO: Physics calculations in FixedUpdate
        _rigidbody.AddForce(Vector3.up);
    }
    
    private void Update()
    {
        // ✅ DO: Input processing and frame-logic in Update
        ProcessInput();
    }
    
    private void LateUpdate()
    {
        // ✅ DO: Camera following logic in LateUpdate (after player moves)
        UpdateCameraPosition();
    }
    
    private void ProcessInput() { /* ... */ }
    private void UpdateCameraPosition() { /* ... */ }
}
```

## Object Pooling (TEngine ObjectPoolModule)

**TEngine Note:** Use `ObjectPoolModule` from TEngine framework instead of custom pools.

```csharp
using TEngine;
using UnityEngine;

public class BulletManager : MonoBehaviour
{
    [SerializeField] private Bullet _bulletPrefab;
    
    private IObjectPoolModule _objectPoolModule;
    
    private void Awake()
    {
        // Get ObjectPoolModule from framework
        _objectPoolModule = ModuleSystem.GetModule<IObjectPoolModule>();
    }
    
    public void FireBullet(Vector3 position, Vector3 direction)
    {
        // Spawn from pool
        var bullet = _objectPoolModule.Spawn(_bulletPrefab.name, _bulletPrefab.gameObject);
        bullet.transform.position = position;
        bullet.GetComponent<Bullet>().Fire(direction);
    }
}

public class Bullet : MonoBehaviour
{
    private void OnDisable()
    {
        // ✅ DO: Return to pool instead of Destroy()
        var objectPoolModule = ModuleSystem.GetModule<IObjectPoolModule>();
        objectPoolModule.Unspawn(gameObject);
    }
    
    public void Fire(Vector3 direction) { /* Physics logic */ }
}
```

## Resource Management (YooAsset - NOT Resources)

**TEngine Note:** Use YooAsset via `IResourceModule` or `GameModule.Resource`. Never use `Resources.Load()`.

```csharp
using Cysharp.Threading.Tasks;
using TEngine;
using UnityEngine;

public class AssetLoader : MonoBehaviour
{
    // ❌ DON'T: Resources.Load (FORBIDDEN in TEngine)
    /*
    private void BadLoad()
    {
        GameObject prefab = Resources.Load<GameObject>("Prefabs/Enemy");
    }
    */
    
    private AssetHandle _handle;
    private GameObject _loadedInstance;

    // ✅ DO: YooAsset with UniTask (TEngine)
    public async UniTaskVoid LoadEnemyAsync()
    {
        // Load via GameModule (hot update domain) or ModuleSystem (main domain)
        _handle = await GameModule.Resource.LoadAssetAsync<GameObject>("Enemy");
        
        if (_handle != null && _handle.AssetObject != null)
        {
            GameObject prefab = _handle.AssetObject as GameObject;
            _loadedInstance = Instantiate(prefab);
        }
    }
    
    // ✅ DO: Sync loading (use sparingly)
    public void LoadEnemySync()
    {
        _handle = GameModule.Resource.LoadAssetSync<GameObject>("Enemy");
        if (_handle != null && _handle.AssetObject != null)
        {
            GameObject prefab = _handle.AssetObject as GameObject;
            _loadedInstance = Instantiate(prefab);
        }
    }
    
    // ✅ DO: Correct Memory Release (framework manages automatically, but you can release manually)
    private void OnDestroy()
    {
        if (_loadedInstance != null)
        {
            Destroy(_loadedInstance);
        }

        // Framework manages handles automatically, but you can release manually if needed
        // _handle?.Release();
    }
}
```

## Memory Management (Zero Allocations)

```csharp
using UnityEngine;
using System.Collections.Generic;
using TMPro;
using System.Text;

public class MemoryOptimization : MonoBehaviour
{
    // ✅ DO: Pre-allocate collections to avoid resizing in runtime
    private readonly List<int> _numbers = new List<int>(100); 

    private void Update()
    {
        // ❌ DON'T: New List allocation or resizing in Update
        // List<int> temp = new List<int>(); 
        
        // ✅ DO: Reuse collections
        _numbers.Clear();
        // Fill list...
    }
}

public class UiOptimization : MonoBehaviour
{
    [SerializeField] private TMP_Text _scoreText;
    
    // ✅ DO: Reusable StringBuilder
    private StringBuilder _sb = new StringBuilder(64);

    public void UpdateScore(string playerName, int score)
    {
        _sb.Clear();
        _sb.Append("Player: ").Append(playerName).Append(", Score: ").Append(score);
        
        // ✅ DO: Pass StringBuilder directly to SetText.
        // Avoids .ToString() which creates a new string allocation every frame.
        _scoreText.SetText(_sb);
    }
}
```

## Async Programming (UniTask)

**TEngine Note:** Use UniTask instead of Coroutines for async operations.

```csharp
using Cysharp.Threading.Tasks;
using TEngine;

public class AsyncExample : MonoBehaviour
{
    // ❌ DON'T: Coroutines
    /*
    private IEnumerator LoadDataCoroutine()
    {
        yield return new WaitForSeconds(1f);
        // ...
    }
    */
    
    // ✅ DO: UniTask
    private async UniTaskVoid LoadDataAsync()
    {
        await UniTask.Delay(1000);
        
        // Load asset asynchronously
        var handle = await GameModule.Resource.LoadAssetAsync<GameObject>("Player");
        // Use handle...
    }
    
    private void Start()
    {
        // Fire and forget
        LoadDataAsync().Forget();
    }
}
```

## Memory Pool (TEngine MemoryPool)

**TEngine Note:** Use TEngine's MemoryPool for temporary allocations.

```csharp
using TEngine;

public class MemoryPoolExample
{
    public void ProcessData()
    {
        // ✅ DO: Use MemoryPool for temporary allocations
        var tempList = MemoryPool.Acquire<List<int>>();
        try
        {
            // Use tempList...
            tempList.Add(1);
            tempList.Add(2);
        }
        finally
        {
            // ✅ DO: Always release
            MemoryPool.Release(tempList);
        }
    }
}
```

## Performance Best Practices

### ✅ DO

- Cache components in `Awake()` or `Start()`
- Use `ObjectPoolModule` for frequently instantiated objects
- Use YooAsset (via `GameModule.Resource`) for all resource loading
- Use UniTask instead of Coroutines
- Pre-allocate collections with initial capacity
- Use `MemoryPool` for temporary allocations
- Use `StringBuilder` for string concatenation in loops
- Release object pool objects instead of `Destroy()`

### ❌ DON'T

- Don't use `Resources.Load()` - use YooAsset
- Don't call `GetComponent()` in Update loops
- Don't allocate new collections in Update
- Don't use Coroutines - use UniTask
- Don't forget to release pooled objects
- Don't use `FindObjectOfType()` in Update
- Don't create strings in Update loops
